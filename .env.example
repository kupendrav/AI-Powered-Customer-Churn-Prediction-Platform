# InsForge managed backend
INSFORGE_URL=https://shzt9f84.ap-southeast.insforge.app
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/insforge?sslmode=require

# Next.js public InsForge client settings
NEXT_PUBLIC_INSFORGE_URL=https://shzt9f84.ap-southeast.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=anon_your_project_anon_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ChurnAI
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]

# Redis
REDIS_URL=redis://redis:6379/0

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=churn-prediction

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
